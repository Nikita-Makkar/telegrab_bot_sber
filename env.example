# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_USER_IDS=123456789,987654321  # Comma-separated admin user IDs

# LLM Provider Selection
# По умолчанию: автоматический выбор (приоритет: Groq -> OpenAI -> Hugging Face)
# Можно явно указать: groq, openai, huggingface, ollama
LLM_PROVIDER=groq  # или openai для использования OpenAI API

# Groq API (БЕСПЛАТНЫЙ - используется по умолчанию!)
# Получите ключ на https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# OpenAI Configuration (для переключения на OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini  # or gpt-3.5-turbo, gpt-4, etc.

# Hugging Face Inference API (бесплатный tier)
# Получите токен на https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_token_here

# Ollama (локальный, полностью бесплатный)
# Установите: https://ollama.ai/
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2  # или другая модель

# Bot Settings
POLL_DURATION_SECONDS=300  # 5 minutes default poll duration
MAX_CODE_LINE_LENGTH=95    # Maximum characters per code line option

# Database
DATABASE_PATH=bot_data.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log

